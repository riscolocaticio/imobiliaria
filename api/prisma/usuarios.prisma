model Usuario {
    id             Int             @id @default(autoincrement())
    imobiliariaId  Int
    nomeCompleto   String
    cpf            String          @unique
    dataNascimento DateTime
    email          String
    login          String          @unique
    passwordHash   String
    role           UsuarioRole     @default(IMOBILIARIA)
    status         StatusRegistro  @default(ATIVO)
    sessaoExpiraEm DateTime?
    createdAt      DateTime        @default(now())
    updatedAt      DateTime        @updatedAt

    imobiliaria           Imobiliaria  @relation(fields: [imobiliariaId], references: [id])
    ocorrenciasRegistradas Ocorrencia[] @relation("OcorrenciaRegistradaPor")
    ocorrenciasExcluidas   Ocorrencia[] @relation("OcorrenciaExcluidaPor")
    auditLogs              AuditLog[]
    contestacoesAbertas    Contestacao[] @relation("ContestacaoAbertaPor")
    contestacoesDecididas  Contestacao[] @relation("ContestacaoDecididaPor")
    documentosEnviados     ContestacaoDocumento[]
    termoAceite            TermoAceite?

    @@index([imobiliariaId])
    @@map("usuarios")
}
