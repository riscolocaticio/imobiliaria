model Imobiliaria {
    id           Int             @id @default(autoincrement())
    razaoSocial  String
    nomeFantasia String?
    cnpj         String          @unique
    email        String
    status       StatusRegistro  @default(ATIVO)
    createdAt    DateTime        @default(now())
    updatedAt    DateTime        @updatedAt

    usuarios      Usuario[]
    ocorrencias   Ocorrencia[]
    auditLogs     AuditLog[]
    contestacoes  Contestacao[]
    notificacoes  Notificacao[]

    @@map("imobiliarias")
}
