PORT=9010

# Local: aponta pro Postgres do docker-compose. Em produção (Neon): DATABASE_URL é a
# connection string com "-pooler" (pgbouncer, usada pelo PrismaClient em runtime),
# DIRECT_URL é a connection string direta (usada só pelo `prisma migrate`).
DATABASE_URL="postgresql://postgres:postgres@localhost:5443/risco_locaticio"
DIRECT_URL="postgresql://postgres:postgres@localhost:5443/risco_locaticio"

JWT_SECRET=""
JWT_EXPIRES_IN="8h"

URL_FRONT_END="http://localhost:8010"

TZ=America/Sao_Paulo
